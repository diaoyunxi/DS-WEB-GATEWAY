# ===== ① Server 公网入口（能力 URL 基址）=====
# 命名 Cloudflare Tunnel 的自有域名（quick tunnel 不可用于常驻）
SERVER_SCHEME=https
SERVER_HOST=dsgw.example.com
SERVER_PORT=443
SERVER_EXTERNAL_URL=
# ≥128bit；留空则启动时随机生成并打印到日志
PATH_TOKEN=
# ②拨入①的共享密钥；留空则随机生成并打印
WS_SECRET=

# ===== ①监听（公网面 / 管理面）=====
SERVER_BIND_HOST=127.0.0.1
SERVER_BIND_PORT=8443
ADMIN_BIND_HOST=127.0.0.1
ADMIN_BIND_PORT=8444
ADMIN_TOKEN=
TRUST_FORWARDED_FOR=true

# ===== DeepSeek 网页 =====
DEEPSEEK_URL=https://chat.deepseek.com/
# cookies：Playwright cookie 数组 JSON（二选一，cookies_file 优先）
COOKIES_FILE=cookies.json
COOKIES_JSON=
HEADLESS=true

# ===== 会话与并发 =====
MAX_CONTEXTS=3
CONTEXT_IDLE_TTL=1800
SKELETON_EVERY_N_TURNS=8

# ===== 信封与交付 =====
ANSWER_SHARD_MAX_CHARS=4000
SHARD_BUFFER_TTL=300
POLL_TIMEOUT=12
RESULT_MAX_BYTES=8192
PENDING_CALL_TTL=600

# ===== 限流（不按 IP）=====
GLOBAL_QPS=5
PER_CODE_QPS=1
RATE_LIMIT_BURST=10

# ===== 告警 SMTP（留空则只记日志）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
ALERT_COOLDOWN=300

# ===== ② Gateway =====
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_BIND_PORT=8080
# 调用方 API Key（逗号分隔；留空 = 不鉴权，仅限内网/测试）
GATEWAY_API_KEYS=
GATEWAY_MODEL_NAME=deepseek-web
# ②拨入①的 WS 地址（同机部署默认即可；分离部署时改成①的内网可达地址）
WS_URL=
REQUEST_TIMEOUT=1800
REPLAY_MAX_CHARS=24000

# ===== 其他 =====
LOG_LEVEL=INFO
DATA_DIR=data
